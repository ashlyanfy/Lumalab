# Database
DATABASE_URL=

# App
PORT=3000
NODE_ENV=development

# CORS — comma-separated, e.g. https://www.lumalab.asia,https://lumalab.asia
# In production a wildcard or empty value will throw on boot.
CORS_ORIGINS=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seed admin (used on first deploy/dev)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- Day 2 features (leave empty for Day 1) ---

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Admin base URL (used in Telegram message links to /leads/:id)
ADMIN_BASE_URL=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
